<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView android:id="@+id/overlayTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔨 REFINEPILOT" android:textColor="@color/text_primary" android:textStyle="bold" />
    <TextView android:id="@+id/overlayState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Waiting for refinement screen…" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/overlayStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Current: ?   Target: +9\nAttempts: 0" android:textColor="@color/text_secondary" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/btnPauseOverlay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pause" />
        <Button android:id="@+id/btnStopOverlay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Stop" />
    </LinearLayout>
</LinearLayout>
